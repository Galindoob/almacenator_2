generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre              String                @db.VarChar(100)
  apellido            String                @db.VarChar(100)
  contrasena          String
  roleid              String                @default(dbgenerated("'28ad34ff-cf2e-4851-a7e7-fffa5d5b53cd'::uuid")) @db.Uuid
  correo              String?               @unique @db.VarChar(255)
  fono                String?               @db.VarChar(60)
  direccion           String?               @db.VarChar(200)
  url_imagen          String?               @db.VarChar(500)
  apertura_caja       apertura_caja[]
  movimiento_de_stock movimiento_de_stock[]
  ventas              venta[]
  configuracion       ConfiguracionUsuario?
  passwordResets      PasswordReset[]
  role                Role                  @relation(fields: [roleid], references: [id], map: "fk_users_role")

  @@map("users")
}

model PasswordReset {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @map("code_hash") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  attempts   Int       @default(0)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset")
}

model Empresa {
  idEmpresa       String                 @id @default(dbgenerated("gen_random_uuid()")) @map("id_empresa") @db.Uuid
  nombreFantasia  String                 @map("nombre_fantasia") @db.VarChar(25)
  rut             String                 @unique @db.VarChar(12)
  nombre          String                 @db.VarChar(120)
  giro            String?                @db.VarChar(120)
  actividad       String?                @db.VarChar(120)
  email           String?                @db.VarChar(255)
  telefono        String?                @db.VarChar(50)
  direccion       String?                @db.VarChar(200)
  comuna          String?                @db.VarChar(100)
  configuraciones ConfiguracionUsuario[]

  @@map("empresa")
}

model Role {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role  String @unique @db.VarChar(50)
  users User[]

  @@map("role")
}

model Marca {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @map("id_marca") @db.Uuid
  nombre    String     @unique @db.VarChar(100)
  productos Producto[]

  @@map("marca")
}

model Categoria {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @map("id_categoria") @db.Uuid
  nombreCategoria String     @unique @map("nombre_categoria") @db.VarChar(100)
  productos       Producto[]

  @@map("categoria")
}

model Unidad {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @map("id_unidad") @db.Uuid
  unidad    String     @unique @db.VarChar(50)
  productos Producto[]

  @@map("unidad")
}

model Producto {
  id                                                   String                @id @default(dbgenerated("gen_random_uuid()")) @map("id_productos") @db.Uuid
  nombre                                               String                @db.VarChar(150)
  descripcion                                          String?               @db.VarChar(500)
  marcaId                                              String                @map("id_marca") @db.Uuid
  codigoBarra                                          String?               @unique @map("codigo_barra") @db.VarChar(100)
  categoriaId                                          String                @map("id_categoria") @db.Uuid
  unidadId                                             String                @map("id_unidad") @db.Uuid
  precioVenta                                          Int                   @map("precio_venta")
  stock                                                Int                   @default(0)
  stockMinimo                                          Int                   @default(10) @map("stock_minimo")
  controlaStock                                        Boolean               @default(true) @map("controla_stock")
  urlImagen                                            String?               @map("url_imagen") @db.VarChar(500)
  costo                                                Int                   @default(0)
  contenido                                            Int?
  unidad_medida                                        String?               @db.Uuid
  empaque                                              String?               @db.Uuid
  id_proveedor                                         String?               @db.Uuid
  promociones                                          promociones[]
  instancia_producto                                   instancia_producto[]
  movimiento_de_stock                                  movimiento_de_stock[]
  detalles                                             detalle[]
  categoria                                            Categoria             @relation(fields: [categoriaId], references: [id], map: "fk_productos_categoria")
  empaque_productos_empaqueToempaque                   empaque?              @relation("productos_empaqueToempaque", fields: [empaque], references: [id_empaque], onDelete: Restrict, map: "fk_productos_empaque")
  marca                                                Marca                 @relation(fields: [marcaId], references: [id], map: "fk_productos_marca")
  proveedores                                          proveedores?          @relation(fields: [id_proveedor], references: [id_proveedor], map: "fk_productos_proveedor")
  unidad                                               Unidad                @relation(fields: [unidadId], references: [id], map: "fk_productos_unidad")
  unidad_medida_productos_unidad_medidaTounidad_medida unidad_medida?        @relation("productos_unidad_medidaTounidad_medida", fields: [unidad_medida], references: [id], onDelete: Restrict, map: "fk_productos_unidad_medida")

  @@map("productos")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model movimiento_de_stock {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fecha          DateTime @default(now()) @db.Timestamp(6)
  costo_sin_iva  Int
  costo_con_iva  Int
  cantidad       Int
  stock_restante Int
  usuario        String   @db.Uuid
  producto       String   @db.Uuid
  comentario     String?  @db.VarChar(500)
  tipo           Int      @default(1)
  productos      Producto @relation(fields: [producto], references: [id], map: "fk_movimiento_stock_producto")
  users          User     @relation(fields: [usuario], references: [id], map: "fk_movimiento_stock_usuario")
}

model unidad_medida {
  id                                               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre                                           String     @unique @db.VarChar(20)
  productos_productos_unidad_medidaTounidad_medida Producto[] @relation("productos_unidad_medidaTounidad_medida")
}

model instancia_producto {
  id_instancia       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_producto        String   @db.Uuid
  fecha_vencimiento  DateTime @db.Timestamp(6)
  id_detalle_reserva String?  @db.Uuid
  reserva            detalle? @relation(fields: [id_detalle_reserva], references: [id_detalle], onDelete: Restrict)
  productos          Producto @relation(fields: [id_producto], references: [id], map: "fk_instancia_producto_producto")

  @@index([id_detalle_reserva])
}

model empaque {
  id_empaque                           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre_empaque                       String     @unique @db.VarChar(100)
  productos_productos_empaqueToempaque Producto[] @relation("productos_empaqueToempaque")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model apertura_caja {
  id_apertura         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_usuario_apertura String    @db.Uuid
  horario_apertura    DateTime  @default(now()) @db.Timestamptz(6)
  horario_cierre      DateTime? @db.Timestamptz(6)
  venta_boleta        Int       @default(0)
  venta_factura       Int       @default(0)
  venta_debito        Int       @default(0)
  venta_credito       Int       @default(0)
  venta_efectivo      Int       @default(0)
  total_debito        Int       @default(0)
  total_credito       Int       @default(0)
  total_efectivo      Int       @default(0)
  saldo_apertura      Int       @default(0)
  saldo_cierre        Int?
  diferencia          Int?
  saldo_esperado      Int       @default(0)
  valor_real          Int       @default(0)
  retiro              Int       @default(0)
  comentario          String?   @db.VarChar(255)
  venta_transferencia Int       @default(0)
  total_transferencia Int       @default(0)
  total               Int       @default(0)
  users               User      @relation(fields: [id_usuario_apertura], references: [id], map: "fk_apertura_caja_usuario")
  ventas              venta[]
  movimientos         movimiento_caja[]
}

model razon_movimiento {
  id_razon     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  razon        String            @unique @db.VarChar(100)
  movimientos  movimiento_caja[]
}

model movimiento_caja {
  id_movimiento    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_apertura_caja String             @db.Uuid
  fecha_movimiento DateTime           @default(now()) @db.Timestamptz(6)
  tipo             String             @db.VarChar(20)
  comentario       String?            @db.VarChar(255)
  id_razon         String?            @db.Uuid
  movimiento       Int
  apertura         apertura_caja      @relation(fields: [id_apertura_caja], references: [id_apertura], onDelete: Restrict)
  razon_detalle    razon_movimiento?  @relation(fields: [id_razon], references: [id_razon], onDelete: Restrict)

  @@index([id_apertura_caja])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model historia_caja {
  id_caja        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fecha_registro DateTime @default(now()) @db.Timestamp(6)
  diferencia     Int      @default(0)
  saldo_apertura Int      @default(0)
  saldo_cierre   Int      @default(0)
}

model proveedores {
  id_proveedor    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre          String     @db.VarChar(150)
  nombre_vendedor String?    @db.VarChar(150)
  correo_contacto String?    @db.VarChar(255)
  telefono        String?    @db.VarChar(50)
  url_imagen      String?    @db.VarChar(500)
  productos       Producto[]
}

model medio_pago {
  id_medio      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  medio_de_pago String  @unique @db.VarChar(50)
  pagos         pagos[]
}

model tipo_promocion {
  id_tipo_promocion String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo              String         @unique @db.VarChar(50)
  promociones       promociones[]
}

model promociones {
  id_promocion      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_tipo_promocion String        @db.Uuid
  nombre_promocion  String        @db.VarChar(150)
  descripcion       String        @db.VarChar(500)
  id_productos      String        @unique @db.Uuid
  descuento         Float?
  cantidad_llevar   Int?
  cantidad_regalo   Int?
  combo             Int?
  precio_combo      Int?
  tipo_promocion    tipo_promocion @relation(fields: [id_tipo_promocion], references: [id_tipo_promocion], onDelete: Restrict)
  producto          Producto       @relation(fields: [id_productos], references: [id], onDelete: Cascade)

  @@index([id_tipo_promocion])
  @@index([id_productos])
}

model venta {
  id_venta          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  num_venta         Int       @unique @default(autoincrement())
  id_vendedor       String    @db.Uuid
  id_apertura_caja  String?   @db.Uuid
  valor_total       Int
  fecha_de_creacion DateTime  @default(now()) @db.Timestamptz(6)
  fecha_pago        DateTime? @db.Timestamptz(6)
  estado            String    @db.VarChar(30)
  vuelto            Int       @default(0)
  redondeo          Int       @default(0)
  recibo            String?   @db.VarChar(500)
  clave_cliente     String?   @unique @db.Uuid
  revision          Int       @default(0)
  vendedor          User      @relation(fields: [id_vendedor], references: [id], onDelete: Restrict, map: "fk_venta_vendedor")
  apertura          apertura_caja? @relation(fields: [id_apertura_caja], references: [id_apertura], onDelete: Restrict)
  detalles          detalle[]
  pagos             pagos[]

  @@index([id_apertura_caja])
}

model detalle {
  id_detalle               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_venta                 String               @db.Uuid
  id_producto              String               @db.Uuid
  costo_adquisicion_actual Int
  cantidad                 Decimal              @db.Decimal(12, 3)
  precio_actual            Int
  promocion_nombre         String?              @db.VarChar(150)
  promocion_condicion      String?              @db.VarChar(200)
  subtotal_venta           Int
  instancias_reservadas    instancia_producto[]
  venta                    venta                @relation(fields: [id_venta], references: [id_venta], onDelete: Restrict, map: "fk_detalle_venta")
  producto                 Producto             @relation(fields: [id_producto], references: [id], onDelete: Restrict, map: "fk_detalle_producto")

  @@unique([id_venta, id_producto])
  @@index([id_venta])
}

model pagos {
  id_pago         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_venta        String     @db.Uuid
  id_medio_pago   String     @db.Uuid
  pago            Int
  clave_operacion String?    @unique @db.Uuid
  venta           venta      @relation(fields: [id_venta], references: [id_venta], onDelete: Restrict, map: "fk_pagos_venta")
  medio_pago      medio_pago @relation(fields: [id_medio_pago], references: [id_medio], onDelete: Restrict, map: "fk_pagos_medio_pago")

  @@index([id_venta])
}

model ConfiguracionUsuario {
  usuarioId      String   @id @map("id_usuario") @db.Uuid
  tema           String   @default("green") @db.VarChar(20)
  escala         Float    @default(1) @map("escala_fuente")
  escalaInterfaz Float    @default(1) @map("escala_interfaz")
  altoContraste  Boolean  @default(false) @map("alto_contraste")
  modoOscuro     Boolean  @default(false) @map("modo_oscuro")
  empresaId      String   @map("empresa") @db.Uuid
  actualizado    DateTime @default(now()) @map("actualizado") @db.Timestamptz(6)
  usuario        User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade, map: "fk_configuracion_usuario")
  datosEmpresa   Empresa  @relation(fields: [empresaId], references: [idEmpresa], onDelete: Restrict, map: "fk_configuracion_usuario_empresa")

  @@map("configuracion_usuario")
}
